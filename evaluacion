        "\n",
        "print(\"Palabras procesadas y ordenadas:\", palabras_ordenadas)\n",
        "\n",
        "frase_limpia = \"\"\n",
        "\n",
        "for caracter in frase:\n",
        "    if caracter.isalpha() or caracter == \" \":\n",
        "        frase_limpia += caracter\n",
        "\n",
        "print(\"Texto limpio:\", frase_limpia)a"
